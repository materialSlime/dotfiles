{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 420,
  "control-center-height": 750,
  "notification-window-width": 400,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "All clear",
  "script-fail-notify": true,
  "scripts": {},
  "notification-visibility": {},
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "notifications",
    "inhibitors"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "  Clear"
    },
    "dnd": {
      "text": "  Do Not Disturb"
    },
    "mpris": {
      "blacklist": [],
      "autohide": false,
      "show-album-art": "always",
      "loop-carousel": true
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "No audio streams",
      "expand-button-label": "  Apps",
      "collapse-button-label": "  Hide",
      "animation-type": "slide_down",
      "animation-duration": 200
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰍬",
          "command": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
        },
        {
          "label": "󰌵",
          "command": "pkill hyprsunset || hyprsunset -t 4000"
        },
        {
          "label": "",
          "command": "hyprshot -m region -o ~/Pictures/Screenshots"
        },
        {
          "label": "󰏘",
          "command": "nwg-look"
        }
      ]
    }
  }
}
