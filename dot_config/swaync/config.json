{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 420,
  "control-center-height": 750,
  "notification-window-width": 400,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "NO NEW MESSAGES",
  "script-fail-notify": true,
  "scripts": {},
  "notification-visibility": {},
  "widgets": [
    "label#header",
    "buttons-grid",
    "dnd",
    "mpris",
    "volume",
    "title",
    "notifications",
    "inhibitors"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": true
    },
    "inhibitors": {
      "text": "INHIBITORS",
      "button-text": "CLEAR",
      "clear-all-button": true
    },
    "title": {
      "text": "NOTIFICATIONS",
      "clear-all-button": true,
      "button-text": "CLEAR"
    },
    "dnd": {
      "text": "DO NOT DISTURB"
    },
    "mpris": {
      "blacklist": [],
      "autohide": false,
      "show-album-art": "always",
      "loop-carousel": true
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "No audio streams",
      "expand-button-label": "APPS",
      "collapse-button-label": "HIDE",
      "animation-type": "slide_down",
      "animation-duration": 200
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰍭",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle.sh mic",
          "update-command": "~/.config/swaync/scripts/toggle.sh mic status"
        },
        {
          "label": "󰊗",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle.sh gamemode",
          "update-command": "~/.config/swaync/scripts/toggle.sh gamemode status"
        },
        {
          "label": "󰑊",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle.sh record",
          "update-command": "~/.config/swaync/scripts/toggle.sh record status"
        },
        {
          "label": "󰌵",
          "type": "toggle",
          "command": "~/.config/swaync/scripts/toggle.sh nightlight",
          "update-command": "~/.config/swaync/scripts/toggle.sh nightlight status"
        },
        {
          "label": "󰹑",
          "command": "swaync-client -cp >/dev/null; sleep 0.3; hyprshot -m region -o ~/Pictures/Screenshots"
        },
        {
          "label": "󰅌",
          "command": "swaync-client -cp >/dev/null; sleep 0.3; ~/.config/wofi/clipboard/clipboard.sh"
        },
        {
          "label": "󰏘",
          "command": "swaync-client -cp >/dev/null; sleep 0.3; uwsm app -- nwg-look"
        }
      ]
    },
    "label#header": {
      "text": "SYS.CTRL",
      "max-lines": 1
    }
  }
}
