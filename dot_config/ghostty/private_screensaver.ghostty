# Screensaver-only Ghostty settings, loaded via --config-file=
# These keys override the user's main config when the screensaver is launched.

# No scrollbar ever
scrollbar = never

# Right-click does nothing
right-click-action = ignore

# No copy-on-select (drag-selecting does nothing)
copy-on-select = false

# No mouse reporting (tte owns the terminal)
mouse-reporting = false

# Hide cursor (no "hidden" value exists — opacity 0 is the actual mechanism)
cursor-style = block
cursor-style-blink = false
cursor-opacity = 0
cursor-color = #000000

# Try to remove window decoration
window-decoration = none

# No padding
window-padding-x = 0
window-padding-y = 0

# Black background
background = #000000
foreground = #ffffff

# Larger font for visibility
font-size = 14
