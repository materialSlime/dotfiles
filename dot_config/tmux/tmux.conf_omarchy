# ==========================================
# Prefix Configuration
# ==========================================
# Change the primary prefix key from the default (Ctrl-b) to Ctrl-Space
set -g prefix C-Space
# Keep Ctrl-b as a secondary fallback prefix
set -g prefix2 C-b
# Allow sending the Ctrl-Space keystroke to the underlying application by pressing it twice
bind C-Space send-prefix

# ==========================================
# Configuration Management
# ==========================================
# Prefix + q reloads this configuration file instantly and displays a message
bind q source-file ~/.config/tmux/tmux.conf \; display "Configuration reloaded"

# ==========================================
# Copy Mode (Scrollback buffer)
# ==========================================
# Use Vim-style keybindings when navigating the copy mode (Prefix + [)
setw -g mode-keys vi
# 'v' starts text selection (like Vim's visual mode)
bind -T copy-mode-vi v send -X begin-selection
# 'y' copies the selected text and exits copy mode (yank)
bind -T copy-mode-vi y send -X copy-selection-and-cancel

# ==========================================
# Pane Controls
# ==========================================
# Prefix + h splits the window vertically (top and bottom panes) in the current directory
bind h split-window -v -c "#{pane_current_path}"
# Prefix + v splits the window horizontally (left and right panes) in the current directory
bind v split-window -h -c "#{pane_current_path}"
# Prefix + x closes the currently active pane
bind x kill-pane

# The '-n' flag means "no prefix". You don't need to press Ctrl-Space first.
# Ctrl + Alt + Arrow Keys navigates between adjacent panes
bind -n C-M-h select-pane -L
bind -n C-M-l select-pane -R
bind -n C-M-k select-pane -U
bind -n C-M-j select-pane -D

# Ctrl + Alt + Shift + Arrow Keys resizes the current pane by 5 cells in the given direction
bind -n C-M-S-Left resize-pane -L 5
bind -n C-M-S-Down resize-pane -D 5
bind -n C-M-S-Up resize-pane -U 5
bind -n C-M-S-Right resize-pane -R 5

# ==========================================
# Window Navigation
# ==========================================
# Prefix + r prompts you to rename the current window
bind r command-prompt -I "#W" "rename-window -- '%%'"
# Prefix + c creates a new window, opening it in the current pane's directory
bind c new-window -c "#{pane_current_path}"
# Prefix + k closes the current window completely
bind k kill-window

# Alt + 1 through 9 switches directly to the corresponding window number (No prefix needed)
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9

# Alt + Left/Right cycles to the previous or next window (No prefix needed)
bind -n M-Left select-window -t -1
bind -n M-Right select-window -t +1
# Alt + Shift + Left/Right moves the current window's position left or right in the tab order
bind -n M-S-Left swap-window -t -1 \; select-window -t -1
bind -n M-S-Right swap-window -t +1 \; select-window -t +1

# ==========================================
# Session Controls
# ==========================================
# Prefix + Shift-R prompts you to rename the current session
bind R command-prompt -I "#S" "rename-session -- '%%'"
# Prefix + Shift-C creates a brand new session starting in the current directory
bind C new-session -c "#{pane_current_path}"
# Prefix + Shift-K kills the entire current session
bind K kill-session
# Prefix + Shift-P or Shift-N switches to the Previous or Next active session
bind P switch-client -p
bind N switch-client -n

# Alt + Up/Down switches to the previous or next session (No prefix needed)
bind -n M-Up switch-client -p
bind -n M-Down switch-client -n

# ==========================================
# General Settings
# ==========================================
# Enable full 256-color and True Color (RGB) support for modern terminals
set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",*:RGB"

# Enable mouse support for clicking panes, selecting windows, and dragging to resize
set -g mouse on

# Start window and pane numbering at 1 instead of 0 (easier to reach on the keyboard)
set -g base-index 1
setw -g pane-base-index 1

# Automatically re-number remaining windows when one is closed so there are no gaps (e.g., 1, 2, 4 becomes 1, 2, 3)
set -g renumber-windows on

# Increase the scrollback buffer size to 50,000 lines
set -g history-limit 50000

# Remove the delay when pressing the Escape key (crucial for Vim/Neovim users)
set -g escape-time 0

# Allow applications inside tmux (like Vim) to detect when they gain or lose focus
set -g focus-events on

# Allow tmux to copy directly to the system clipboard
set -g set-clipboard on

# Allow applications to send escape sequences directly to the terminal (often used for rendering images in terminal)
set -g allow-passthrough on

# Resize the window to the size of the smallest viewing client (helpful if multiple clients of different sizes are attached)
setw -g aggressive-resize on

# If you kill the current session, tmux will switch to another active session instead of kicking you out to the standard terminal
set -g detach-on-destroy off

# ==========================================
# Status Bar Configuration
# ==========================================
# Move the status bar to the top of the terminal
set -g status-position top
# Update the status bar every 5 seconds
set -g status-interval 5
# Set the maximum lengths for the left and right sides of the status bar
set -g status-left-length 30
set -g status-right-length 50
# Remove the default space/separator between window tabs
set -g window-status-separator ""

# Automatically rename windows dynamically based on the current directory name
set -gw automatic-rename on
set -gw automatic-rename-format '#{b:pane_current_path}'

# ==========================================
# Theme & Colors
# ==========================================
# Make the status bar background transparent (default) and text default
set -g status-style "bg=default,fg=default"

# Left side of status bar: Shows the Session name (#S) in bold black text on a blue background
set -g status-left "#[fg=black,bg=blue,bold] #S #[bg=default] "

# Right side of status bar: 
# Shows "COPY" if in copy mode, "PREFIX" if prefix is pressed, "ZOOM" if pane is zoomed.
# Ends with the hostname (#h) in dark gray.
set -g status-right "#[fg=blue]#{?pane_in_mode,COPY ,}#{?client_prefix,PREFIX ,}#{?window_zoomed_flag,ZOOM ,}#[fg=brightblack]#h "

# Format for inactive windows: Dark gray text showing Index:Name
set -g window-status-format "#[fg=brightblack] #I:#W "
# Format for active window: Bold blue text showing Index:Name
set -g window-status-current-format "#[fg=blue,bold] #I:#W "

# Styling for pane dividers: Inactive dividers are dark gray, active divider is blue
set -g pane-border-style "fg=brightblack"
set -g pane-active-border-style "fg=blue"

# Styling for tmux command prompts and messages: Blue text on transparent background
set -g message-style "bg=default,fg=blue"
set -g message-command-style "bg=default,fg=blue"

# Highlight color for text selection in copy mode: Black text on blue background
set -g mode-style "bg=blue,fg=black"

# Color of the large clock triggered by Prefix + t
setw -g clock-mode-colour blue
