#!/usr/bin/env python3
"""Generate every app's color file from ~/.config/theme/palette, then reload apps.

Outputs (all in ~/.config/theme/gen/ unless noted):
  colors.css     GTK @define-color     -> waybar, wofi, swaync, swayosd
  colors.lua     Lua table             -> hypr/looknfeel.lua
  colors.conf    hyprlang $variables   -> hypr/hyprlock.conf
  colors.sh      shell exports         -> scripts
  ghostty        ghostty theme         -> ghostty/config.ghostty (theme = ...)
  btop.theme     btop theme            -> btop/btop.conf (color_theme = ...)
  sddm.conf      SDDM theme.conf.user  -> install with: build --sddm (needs sudo)
                 (one-time: SDDM's Main.qml must be the palette-aware copy in ~/.config/theme/sddm/)
  gtk3.css       adw-gtk3 colors       -> gtk-3.0/gtk.css (@import; needs adw-gtk3-dark theme)
  gtk4.css       libadwaita colors     -> gtk-4.0/gtk.css (@import)
  starship.toml  palette block rewritten in place between the theme-build markers

Usage: build            generate + reload
       build --no-reload
       build --sddm     also install the SDDM colors (asks for sudo)
"""
import os
import re
import subprocess
import sys
from pathlib import Path

THEME = Path(__file__).resolve().parent
GEN = THEME / "gen"
CONFIG = THEME.parent
SDDM_DIR = Path("/usr/share/sddm/themes/cyberpunk")


# ── palette ──────────────────────────────────────────────────────
def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def rgb2hex(c):
    return "#{:02X}{:02X}{:02X}".format(*c)


def mix(a, b, t):
    """Mix hex a toward hex b by fraction t (0 = a, 1 = b)."""
    a, b = hex2rgb(a), hex2rgb(b)
    return rgb2hex(tuple(round(x + (y - x) * t) for x, y in zip(a, b)))


def load_palette():
    pal = {}
    for n, line in enumerate((THEME / "palette").read_text().splitlines(), 1):
        # comments are '#' followed by a space (so '#RRGGBB' values survive)
        line = re.sub(r"(^|\s)#(\s.*)?$", "", line).strip()
        if not line:
            continue
        m = re.fullmatch(r"([a-z_]+)\s*=\s*(#[0-9A-Fa-f]{6})", line)
        if not m:
            sys.exit(f"palette:{n}: can't parse '{line}' (expected: name = #RRGGBB)")
        pal[m[1]] = m[2].upper()
    for req in ("bg", "primary", "secondary", "accent", "text", "muted", "surface", "tertiary", "bright", "ansi_magenta", "ansi_purple"):
        if req not in pal:
            sys.exit(f"palette: missing required color '{req}'")
    pal.setdefault("bg_dark", mix(pal["bg"], "#000000", 0.3))
    pal.setdefault("primary_dim", mix(pal["primary"], pal["bg"], 0.35))
    pal.setdefault("secondary_dim", mix(pal["secondary"], pal["bg"], 0.65))
    return pal


HEADER = "Generated by ~/.config/theme/build from ~/.config/theme/palette. Do not edit."


# ── generators ───────────────────────────────────────────────────
def gen_css(p):
    lines = [f"/* {HEADER} */"]
    lines += [f"@define-color {k} {v};" for k, v in p.items()]
    return "\n".join(lines) + "\n"


def gen_lua(p):
    lines = [f"-- {HEADER}", "-- c.hex.primary = \"#F75049\"; c.primary = \"rgb(F75049)\"; c.rgba(\"primary\", 0.5) = \"rgba(F7504980)\"", "local c = { hex = {} }"]
    for k, v in p.items():
        lines.append(f'c.hex.{k} = "{v}"')
        lines.append(f'c.{k} = "rgb({v[1:]})"')
    lines += [
        "function c.rgba(name, a)",
        "\treturn string.format(\"rgba(%s%02x)\", c.hex[name]:sub(2), math.floor(a * 255 + 0.5))",
        "end",
        "return c",
    ]
    return "\n".join(lines) + "\n"


def gen_hyprlang(p):
    # $c_<name> = "r, g, b"  -> use as rgba($c_primary, 0.5)
    # $x_<name> = "#RRGGBB"  -> use inside pango markup: foreground='$x_primary'
    lines = [f"# {HEADER}"]
    for k, v in p.items():
        lines.append(f"$c_{k} = {', '.join(map(str, hex2rgb(v)))}")
    for k, v in p.items():
        lines.append(f"$x_{k} = #{v}")  # '##' is hyprlang's escaped '#'
    return "\n".join(lines) + "\n"


def gen_sh(p):
    lines = [f"# {HEADER}"] + [f"export C_{k.upper()}='{v}'" for k, v in p.items()]
    return "\n".join(lines) + "\n"


def gen_ghostty(p):
    bright = lambda c: mix(c, p["bright"], 0.25)
    ansi = [
        p["bg_dark"], p["primary"], p["secondary"], p["accent"],
        p["primary"], p["ansi_magenta"], p["secondary"], p["text"],
        p["muted"], bright(p["primary"]), bright(p["secondary"]), bright(p["accent"]),
        p["ansi_purple"], bright(p["ansi_magenta"]), bright(p["secondary"]), p["bright"],
    ]
    lines = [f"# {HEADER}"] + [f"palette = {i}={c}" for i, c in enumerate(ansi)]
    lines += [
        f"background = {p['bg']}",
        f"foreground = {p['secondary']}",
        f"cursor-color = {p['secondary']}",
        f"cursor-text = {p['bg']}",
        f"selection-background = {p['accent']}",
        f"selection-foreground = {p['bg']}",
        f"split-divider-color = {p['primary']}",
    ]
    return "\n".join(lines) + "\n"


def gen_btop(p):
    t = {
        "main_bg": p["bg"], "main_fg": p["text"], "title": p["secondary"],
        "hi_fg": p["primary"], "selected_bg": p["surface"], "selected_fg": p["accent"],
        "inactive_fg": p["muted"], "graph_text": p["muted"], "meter_bg": p["surface"],
        "proc_misc": p["secondary"], "cpu_box": p["primary"], "mem_box": p["secondary"],
        "net_box": p["accent"], "proc_box": p["primary"], "div_line": p["surface"],
        "temp_start": p["secondary"], "temp_mid": p["accent"], "temp_end": p["primary"],
        "cpu_start": p["secondary"], "cpu_mid": p["accent"], "cpu_end": p["primary"],
        "free_start": p["secondary_dim"], "free_mid": p["secondary"], "free_end": p["secondary"],
        "cached_start": p["tertiary"], "cached_mid": p["tertiary"], "cached_end": p["secondary"],
        "available_start": p["accent"], "available_mid": p["accent"], "available_end": p["accent"],
        "used_start": p["primary_dim"], "used_mid": p["primary"], "used_end": p["primary"],
        "download_start": p["secondary_dim"], "download_mid": p["secondary"], "download_end": p["secondary"],
        "upload_start": p["primary_dim"], "upload_mid": p["primary"], "upload_end": p["accent"],
        "process_start": p["secondary"], "process_mid": p["accent"], "process_end": p["primary"],
    }
    lines = [f"# {HEADER}"] + [f'theme[{k}]="{v}"' for k, v in t.items()]
    return "\n".join(lines) + "\n"


def gen_sddm(p):
    lines = [f"# {HEADER}", "[General]"] + [f"c_{k}={v}" for k, v in p.items()]
    return "\n".join(lines) + "\n"


def gtk_roles(p):
    """libadwaita / adw-gtk3 named colors, mapped onto palette roles."""
    return {
        "accent_bg_color": p["accent"],    "accent_fg_color": p["bg"],    "accent_color": p["accent"],
        "destructive_bg_color": p["primary"], "destructive_fg_color": p["bg"], "destructive_color": p["primary"],
        "success_bg_color": p["secondary"], "success_fg_color": p["bg"],  "success_color": p["secondary"],
        "warning_bg_color": p["accent"],   "warning_fg_color": p["bg"],   "warning_color": p["accent"],
        "error_bg_color": p["primary"],    "error_fg_color": p["bg"],     "error_color": p["primary"],
        "window_bg_color": p["bg"],        "window_fg_color": p["text"],
        "view_bg_color": p["bg_dark"],     "view_fg_color": p["text"],
        "headerbar_bg_color": p["bg_dark"], "headerbar_fg_color": p["text"],
        "headerbar_border_color": p["primary"], "headerbar_backdrop_color": p["bg"],
        "sidebar_bg_color": p["surface"],  "sidebar_fg_color": p["text"],
        "sidebar_backdrop_color": p["surface"], "sidebar_border_color": p["bg_dark"],
        "card_bg_color": p["surface"],     "card_fg_color": p["text"],
        "dialog_bg_color": p["bg"],        "dialog_fg_color": p["text"],
        "popover_bg_color": p["surface"],  "popover_fg_color": p["text"],
        "thumbnail_bg_color": p["surface"], "thumbnail_fg_color": p["text"],
    }


def gen_gtk3(p):
    lines = [f"/* {HEADER} */", "/* adw-gtk3 named colors, imported by ~/.config/gtk-3.0/gtk.css */"]
    lines += [f"@define-color {k} {v};" for k, v in gtk_roles(p).items()]
    return "\n".join(lines) + "\n"


def gen_gtk4(p):
    lines = [f"/* {HEADER} */", "/* libadwaita colors, imported by ~/.config/gtk-4.0/gtk.css */", ":root {"]
    lines += [f"  --{k.replace('_', '-')}: {v};" for k, v in gtk_roles(p).items()]
    lines.append("}")
    return "\n".join(lines) + "\n"


STARSHIP_BEGIN = "# >>> theme-build palette >>>"
STARSHIP_END = "# <<< theme-build palette <<<"


def patch_starship(p):
    path = CONFIG / "starship.toml"
    if not path.exists():
        return
    text = path.read_text()
    block = [STARSHIP_BEGIN, f"# {HEADER}", "[palettes.cyberpunk]"]
    block += [f'{k} = "{v}"' for k, v in p.items()]
    block.append(STARSHIP_END)
    new, n = re.subn(re.escape(STARSHIP_BEGIN) + r".*?" + re.escape(STARSHIP_END),
                     "\n".join(block), text, flags=re.S)
    if n == 0:
        print("starship.toml: palette markers not found, skipped")
    elif new != text:
        path.write_text(new)


# ── reload ───────────────────────────────────────────────────────
def sh(cmd):
    subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def reload_apps():
    sh("hyprctl reload")
    sh("pkill -SIGUSR2 -x waybar")               # reload waybar style
    sh("swaync-client --reload-css")
    sh("pkill -SIGUSR2 -x ghostty")              # ghostty reloads config on USR2
    sh("tmux source-file ~/.config/tmux/tmux.conf")
    # swayosd-server has no CSS reload; restart it detached
    sh("pkill -x swayosd-server; setsid -f uwsm app -- swayosd-server")


def main():
    args = sys.argv[1:]
    p = load_palette()
    GEN.mkdir(exist_ok=True)
    outputs = {
        "colors.css": gen_css(p),
        "colors.lua": gen_lua(p),
        "colors.conf": gen_hyprlang(p),
        "colors.sh": gen_sh(p),
        "ghostty": gen_ghostty(p),
        "btop.theme": gen_btop(p),
        "sddm.conf": gen_sddm(p),
        "gtk3.css": gen_gtk3(p),
        "gtk4.css": gen_gtk4(p),
    }
    for name, content in outputs.items():
        (GEN / name).write_text(content)
    patch_starship(p)
    print(f"generated {len(outputs)} files in {GEN}")

    if "--sddm" in args:
        dest = SDDM_DIR / "theme.conf.user"
        r = subprocess.run(["sudo", "install", "-m644", str(GEN / "sddm.conf"), str(dest)])
        print(f"sddm: {'installed ' + str(dest) if r.returncode == 0 else 'install failed'}")
    if "--no-reload" not in args:
        reload_apps()
        print("reloaded hyprland, waybar, swaync, swayosd, ghostty, tmux (btop/starship: next launch/prompt)")


if __name__ == "__main__":
    main()
