#!/usr/bin/env python3
"""Generate every app's color file from ~/.config/theme/palette, then reload apps.

Outputs (all in ~/.config/theme/gen/ unless noted):
  colors.css     GTK @define-color     -> waybar, wofi, swaync, swayosd
  colors.lua     Lua table             -> hypr/looknfeel.lua
  colors.conf    hyprlang $variables   -> hypr/hyprlock.conf
  colors.sh      shell exports         -> scripts
  ghostty        ghostty theme         -> ghostty/config.ghostty (theme = ...)
  btop.theme     btop theme            -> btop/btop.conf (color_theme = ...)
  sddm.conf      SDDM theme.conf.user (colors + hostname/OS/kernel for the HOST panel)
  SDDM theme     build --sddm-stage DIR renders the whole theme into DIR (no sudo):
                   base files (sddm/base/: metadata, theme.conf, Rajdhani font + OFL,
                   bg.jpg), Main.qml (sddm/), theme.conf.user,
                   bg.jpg re-rendered by sddm/background.py if that script exists locally,
                   avatars/<user>.png (~/.face.icon as a square; without one the
                   login screen draws the user's initial itself)
                 build --sddm stages it and installs it into the SDDM theme (needs sudo)
  gtk3.css       adw-gtk3 colors       -> gtk-3.0/gtk.css (@import; needs adw-gtk3-dark theme)
  gtk4.css       libadwaita colors     -> gtk-4.0/gtk.css (@import)
  zen.css        Zen browser colors    -> <zen profile>/chrome/palette.css (symlink) -> userChrome.css
  starship.toml  palette block rewritten in place between the theme-build markers
  waybar/        recolored copies of ~/.config/waybar/assets/{panels,frames}/*.svg -> waybar/style.css
  wofi/          recolored copies of ~/.config/wofi/shared/assets/*.svg                  -> wofi/*.css
  swaync/        recolored copies of ~/.config/swaync/assets/*.svg                -> swaync/style.css
                 (sources keep their Inkscape colors; SVG_COLORS maps each one to a palette role)

Usage: build            generate + reload
       build --no-reload
       build --sddm     also render + install the SDDM theme (asks for sudo)
       build --sddm-stage DIR   only render the SDDM theme into DIR (used by sddm/preview.sh)
"""
import os
import re
import subprocess
import sys
from pathlib import Path

THEME = Path(__file__).resolve().parent
GEN = THEME / "gen"
CONFIG = THEME.parent
SDDM_DIR = Path("/usr/share/sddm/themes/cyberpunk")


# ── palette ──────────────────────────────────────────────────────
def hex2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def rgb2hex(c):
    return "#{:02X}{:02X}{:02X}".format(*c)


def mix(a, b, t):
    """Mix hex a toward hex b by fraction t (0 = a, 1 = b)."""
    a, b = hex2rgb(a), hex2rgb(b)
    return rgb2hex(tuple(round(x + (y - x) * t) for x, y in zip(a, b)))


def load_palette():
    pal = {}
    for n, line in enumerate((THEME / "palette").read_text().splitlines(), 1):
        # comments are '#' followed by a space (so '#RRGGBB' values survive)
        line = re.sub(r"(^|\s)#(\s.*)?$", "", line).strip()
        if not line:
            continue
        m = re.fullmatch(r"([a-z_]+)\s*=\s*(#[0-9A-Fa-f]{6})", line)
        if not m:
            sys.exit(f"palette:{n}: can't parse '{line}' (expected: name = #RRGGBB)")
        pal[m[1]] = m[2].upper()
    for req in ("bg", "primary", "secondary", "accent", "text", "muted", "surface", "tertiary", "bright", "ansi_magenta", "ansi_purple"):
        if req not in pal:
            sys.exit(f"palette: missing required color '{req}'")
    pal.setdefault("bg_dark", mix(pal["bg"], "#000000", 0.3))
    pal.setdefault("primary_dim", mix(pal["primary"], pal["bg"], 0.35))
    pal.setdefault("secondary_dim", mix(pal["secondary"], pal["bg"], 0.65))
    return pal


HEADER = "Generated by ~/.config/theme/build from ~/.config/theme/palette. Do not edit."


# ── generators ───────────────────────────────────────────────────
def gen_css(p):
    lines = [f"/* {HEADER} */"]
    lines += [f"@define-color {k} {v};" for k, v in p.items()]
    return "\n".join(lines) + "\n"


def gen_lua(p):
    lines = [f"-- {HEADER}", "-- c.hex.primary = \"#F75049\"; c.primary = \"rgb(F75049)\"; c.rgba(\"primary\", 0.5) = \"rgba(F7504980)\"", "local c = { hex = {} }"]
    for k, v in p.items():
        lines.append(f'c.hex.{k} = "{v}"')
        lines.append(f'c.{k} = "rgb({v[1:]})"')
    lines += [
        "function c.rgba(name, a)",
        "\treturn string.format(\"rgba(%s%02x)\", c.hex[name]:sub(2), math.floor(a * 255 + 0.5))",
        "end",
        "return c",
    ]
    return "\n".join(lines) + "\n"


def gen_hyprlang(p):
    # $c_<name> = "r, g, b"  -> use as rgba($c_primary, 0.5)
    # $x_<name> = "#RRGGBB"  -> use inside pango markup: foreground='$x_primary'
    lines = [f"# {HEADER}"]
    for k, v in p.items():
        lines.append(f"$c_{k} = {', '.join(map(str, hex2rgb(v)))}")
    for k, v in p.items():
        lines.append(f"$x_{k} = #{v}")  # '##' is hyprlang's escaped '#'
    return "\n".join(lines) + "\n"


def gen_sh(p):
    lines = [f"# {HEADER}"] + [f"export C_{k.upper()}='{v}'" for k, v in p.items()]
    return "\n".join(lines) + "\n"


def gen_ghostty(p):
    bright = lambda c: mix(c, p["bright"], 0.25)
    ansi = [
        p["bg_dark"], p["primary"], p["secondary"], p["accent"],
        p["primary"], p["ansi_magenta"], p["secondary"], p["text"],
        p["muted"], bright(p["primary"]), bright(p["secondary"]), bright(p["accent"]),
        p["ansi_purple"], bright(p["ansi_magenta"]), bright(p["secondary"]), p["bright"],
    ]
    lines = [f"# {HEADER}"] + [f"palette = {i}={c}" for i, c in enumerate(ansi)]
    lines += [
        f"background = {p['bg']}",
        f"foreground = {p['secondary']}",
        f"cursor-color = {p['secondary']}",
        f"cursor-text = {p['bg']}",
        f"selection-background = {p['accent']}",
        f"selection-foreground = {p['bg']}",
        f"split-divider-color = {p['primary']}",
    ]
    return "\n".join(lines) + "\n"


def gen_btop(p):
    t = {
        "main_bg": p["bg"], "main_fg": p["text"], "title": p["secondary"],
        "hi_fg": p["primary"], "selected_bg": p["surface"], "selected_fg": p["accent"],
        "inactive_fg": p["muted"], "graph_text": p["muted"], "meter_bg": p["surface"],
        "proc_misc": p["secondary"], "cpu_box": p["primary"], "mem_box": p["secondary"],
        "net_box": p["accent"], "proc_box": p["primary"], "div_line": p["surface"],
        "temp_start": p["secondary"], "temp_mid": p["accent"], "temp_end": p["primary"],
        "cpu_start": p["secondary"], "cpu_mid": p["accent"], "cpu_end": p["primary"],
        "free_start": p["secondary_dim"], "free_mid": p["secondary"], "free_end": p["secondary"],
        "cached_start": p["tertiary"], "cached_mid": p["tertiary"], "cached_end": p["secondary"],
        "available_start": p["accent"], "available_mid": p["accent"], "available_end": p["accent"],
        "used_start": p["primary_dim"], "used_mid": p["primary"], "used_end": p["primary"],
        "download_start": p["secondary_dim"], "download_mid": p["secondary"], "download_end": p["secondary"],
        "upload_start": p["primary_dim"], "upload_mid": p["primary"], "upload_end": p["accent"],
        "process_start": p["secondary"], "process_mid": p["accent"], "process_end": p["primary"],
    }
    lines = [f"# {HEADER}"] + [f'theme[{k}]="{v}"' for k, v in t.items()]
    return "\n".join(lines) + "\n"


def host_info():
    """OS name and kernel for the SDDM HOST panel (a greeter can't run commands)."""
    os_name = "Linux"
    try:
        for line in open("/etc/os-release"):
            if line.startswith("NAME="):
                os_name = line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return os_name, os.uname().release


def gen_sddm(p):
    os_name, kernel = host_info()
    lines = [f"# {HEADER}", "[General]"] + [f"c_{k}={v}" for k, v in p.items()]
    lines += [f"host_os={os_name}", f"host_kernel={kernel}", f"host_name={os.uname().nodename}"]
    return "\n".join(lines) + "\n"


def stage_sddm(stage):
    """Render every file of the SDDM theme into `stage` (no sudo needed)."""
    stage = Path(stage)
    stage.mkdir(parents=True, exist_ok=True)
    # base files that never change: metadata.desktop, theme.conf, font/
    base = THEME / "sddm" / "base"
    for src in base.rglob("*"):
        if src.is_file():
            dst = stage / src.relative_to(base)
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_bytes(src.read_bytes())
    frame = str(CONFIG / "hypr" / "Scripts" / "cover-frame.py")
    # background: base/bg.jpg (copied above), re-rendered in the current palette
    # when the local generator exists (it isn't kept in the dotfiles repo)
    gen_bg = THEME / "sddm" / "background.py"
    if gen_bg.exists():
        subprocess.run([sys.executable, str(gen_bg), str(stage / "bg.jpg")], check=True)
    # avatar: ~/.face.icon (or ~/.face) as a 512px square, saved per user as
    # avatars/<user>.png. It's copied into the theme because SDDM can't read a
    # private home folder. Users without a picture get their initial, drawn by Main.qml.
    face = next((f for f in (Path.home() / ".face.icon", Path.home() / ".face") if f.is_file()), None)
    if face:
        (stage / "avatars").mkdir(exist_ok=True)
        user = os.environ.get("USER") or Path.home().name
        subprocess.run([sys.executable, frame, "square", str(face), str(stage / "avatars" / f"{user}.png")], check=True)
    (stage / "theme.conf.user").write_bytes((GEN / "sddm.conf").read_bytes())
    (stage / "Main.qml").write_bytes((THEME / "sddm" / "Main.qml").read_bytes())
    return stage


def install_sddm():
    """Stage the theme, then install it with sudo."""
    stage = stage_sddm(GEN / "sddm-stage")
    # keep the original background / QML once, the first time this runs
    for name in ("bg.jpg", "Main.qml"):
        src, orig = SDDM_DIR / name, SDDM_DIR / f"{name}.orig"
        if src.exists() and not orig.exists():
            subprocess.run(["sudo", "cp", str(src), str(orig)])
    ok = True
    # every staged file, base files included; -D creates the theme folder on a fresh system
    for src in sorted(f for f in stage.rglob("*") if f.is_file()):
        dst = SDDM_DIR / src.relative_to(stage)
        ok &= subprocess.run(["sudo", "install", "-D", "-m644", str(src), str(dst)]).returncode == 0
    # files from earlier versions of the dock that are no longer used
    for old in ("host.png", "avatar.png"):
        if (SDDM_DIR / old).exists():
            subprocess.run(["sudo", "rm", "-f", str(SDDM_DIR / old)])
    print(f"sddm: {'installed theme into ' + str(SDDM_DIR) if ok else 'install failed'}")

def gtk_roles(p):
    """libadwaita / adw-gtk3 named colors, mapped onto palette roles."""
    return {
        "accent_bg_color": p["accent"],    "accent_fg_color": p["bg"],    "accent_color": p["accent"],
        "destructive_bg_color": p["primary"], "destructive_fg_color": p["bg"], "destructive_color": p["primary"],
        "success_bg_color": p["secondary"], "success_fg_color": p["bg"],  "success_color": p["secondary"],
        "warning_bg_color": p["accent"],   "warning_fg_color": p["bg"],   "warning_color": p["accent"],
        "error_bg_color": p["primary"],    "error_fg_color": p["bg"],     "error_color": p["primary"],
        "window_bg_color": p["bg"],        "window_fg_color": p["text"],
        "view_bg_color": p["bg_dark"],     "view_fg_color": p["text"],
        "headerbar_bg_color": p["bg_dark"], "headerbar_fg_color": p["text"],
        "headerbar_border_color": p["primary"], "headerbar_backdrop_color": p["bg"],
        "sidebar_bg_color": p["surface"],  "sidebar_fg_color": p["text"],
        "sidebar_backdrop_color": p["surface"], "sidebar_border_color": p["bg_dark"],
        "card_bg_color": p["surface"],     "card_fg_color": p["text"],
        "dialog_bg_color": p["bg"],        "dialog_fg_color": p["text"],
        "popover_bg_color": p["surface"],  "popover_fg_color": p["text"],
        "thumbnail_bg_color": p["surface"], "thumbnail_fg_color": p["text"],
    }


def gen_gtk3(p):
    lines = [f"/* {HEADER} */", "/* adw-gtk3 named colors, imported by ~/.config/gtk-3.0/gtk.css */"]
    lines += [f"@define-color {k} {v};" for k, v in gtk_roles(p).items()]
    return "\n".join(lines) + "\n"


def gen_gtk4(p):
    lines = [f"/* {HEADER} */", "/* libadwaita colors, imported by ~/.config/gtk-4.0/gtk.css */", ":root {"]
    lines += [f"  --{k.replace('_', '-')}: {v};" for k, v in gtk_roles(p).items()]
    lines.append("}")
    return "\n".join(lines) + "\n"


def gen_zen(p):
    """Zen browser chrome colors. Zen derives most of its UI from a few variables
    (see zen-styles/zen-theme.css inside /opt/zen-browser-bin/browser/omni.ja):
    --zen-primary-color is mixed into tints, hover and selection; --zen-branding-dark/
    -paper are its dark-mode background/foreground. !important beats both Zen's own
    sheets and the workspace gradient, which Zen sets as an inline style."""
    v = {
        "--zen-branding-dark": p["bg"],
        "--zen-branding-paper": p["text"],
        "--zen-primary-color": p["primary"],
        "--zen-main-browser-background": p["bg"],
        "--zen-main-browser-background-toolbar": p["bg"],
        "--zen-themed-toolbar-bg-transparent": p["bg"],
        "--zen-dialog-background": p["surface"],
        "--zen-colors-border": p["primary_dim"],
        "--arrowpanel-background": p["surface"],
        "--arrowpanel-color": p["text"],
        "--toolbox-textcolor": p["text"],
        "--focus-outline-color": p["accent"],
    }
    lines = [f"/* {HEADER} */",
             "/* Zen browser colors, imported by <profile>/chrome/userChrome.css via palette.css */",
             ":root {"]
    lines += [f"  {k}: {c} !important;" for k, c in v.items()]
    lines.append("}")
    # The frame behind tabs/sidebar is painted by these two elements, and Zen's theme
    # picker sets the variables inline ON them (ZenGradientGenerator.mjs), which wins
    # over anything inherited from :root. Target them directly; *-old is the value
    # Zen crossfades from when switching workspaces.
    bg_vars = ["--zen-main-browser-background", "--zen-main-browser-background-toolbar",
               "--zen-main-browser-background-old", "--zen-main-browser-background-toolbar-old"]
    lines.append("#zen-browser-background,")
    lines.append("#zen-toolbar-background {")
    lines += [f"  {k}: {p['bg']} !important;" for k in bg_vars]
    lines.append("}")
    return "\n".join(lines) + "\n"


# Colors the waybar/wofi SVGs are drawn with in Inkscape -> what build paints them with.
# A role name, or (role, t) = that role mixed t toward bg. Add a line here when an
# SVG uses a new color; build warns about any it doesn't know and leaves it as is.
SVG_COLORS = {
    "#0E0F18": "bg",                # panel fill
    "#C7373E": ("primary", 0.2),    # panel outline
    "#682628": ("primary", 0.62),   # tooltip inner fill
    "#522226": ("primary", 0.7),    # memory panel inner fill
    "#000000": None,                # tooltip shadow: keep
    "#1A1B2E": "surface",           # wofi field/highlight fill
    "#F3E900": "accent",            # wofi highlight
}
SVG_COLOR_RE = re.compile(r"((?:fill|stroke|stop-color)\s*(?::|=\s*\")\s*)(#[0-9A-Fa-f]{6})")


# source dir -> output dir (under gen/)
SVG_DIRS = {
    CONFIG / "waybar" / "assets" / "panels": "waybar/panels",
    CONFIG / "waybar" / "assets" / "frames": "waybar/frames",
    CONFIG / "wofi" / "shared" / "assets": "wofi",
    CONFIG / "swaync" / "assets": "swaync",
}


def gen_svgs(p):
    unknown = set()

    def recolor(m):
        src = m[2].upper()
        if src not in SVG_COLORS:
            unknown.add(src)
            return m[0]
        role = SVG_COLORS[src]
        if role is None:
            return m[0]
        new = mix(p[role[0]], p["bg"], role[1]) if isinstance(role, tuple) else p[role]
        return m[1] + new

    count = 0
    for src_dir, out in SVG_DIRS.items():
        out_dir = GEN / out
        out_dir.mkdir(parents=True, exist_ok=True)
        for svg in sorted(src_dir.glob("*.svg")):
            # no header comment: GTK only sniffs the first few hundred bytes for '<svg'
            (out_dir / svg.name).write_text(SVG_COLOR_RE.sub(recolor, svg.read_text()))
            count += 1
    for c in sorted(unknown):
        print(f"svg: {c} not in SVG_COLORS, left unchanged")
    return count


STARSHIP_BEGIN = "# >>> theme-build palette >>>"
STARSHIP_END = "# <<< theme-build palette <<<"


def patch_starship(p):
    path = CONFIG / "starship.toml"
    if not path.exists():
        return
    text = path.read_text()
    block = [STARSHIP_BEGIN, f"# {HEADER}", "[palettes.cyberpunk]"]
    block += [f'{k} = "{v}"' for k, v in p.items()]
    block.append(STARSHIP_END)
    new, n = re.subn(re.escape(STARSHIP_BEGIN) + r".*?" + re.escape(STARSHIP_END),
                     "\n".join(block), text, flags=re.S)
    if n == 0:
        print("starship.toml: palette markers not found, skipped")
    elif new != text:
        path.write_text(new)


# ── reload ───────────────────────────────────────────────────────
def sh(cmd):
    subprocess.run(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def reload_apps():
    sh("hyprctl reload")
    sh("pkill -SIGUSR2 -x waybar")               # reload waybar style
    sh("swaync-client --reload-css")
    sh("pkill -SIGUSR2 -x ghostty")              # ghostty reloads config on USR2
    sh("tmux source-file ~/.config/tmux/tmux.conf")
    # swayosd-server has no CSS reload; restart it detached
    sh("pkill -x swayosd-server; setsid -f uwsm app -- swayosd-server")


def main():
    args = sys.argv[1:]
    p = load_palette()
    GEN.mkdir(exist_ok=True)
    outputs = {
        "colors.css": gen_css(p),
        "colors.lua": gen_lua(p),
        "colors.conf": gen_hyprlang(p),
        "colors.sh": gen_sh(p),
        "ghostty": gen_ghostty(p),
        "btop.theme": gen_btop(p),
        "sddm.conf": gen_sddm(p),
        "gtk3.css": gen_gtk3(p),
        "gtk4.css": gen_gtk4(p),
        "zen.css": gen_zen(p),
    }
    for name, content in outputs.items():
        (GEN / name).write_text(content)
    patch_starship(p)
    svgs = gen_svgs(p)
    print(f"generated {len(outputs)} files + {svgs} svgs in {GEN}")

    if "--sddm-stage" in args:
        print(f"sddm: staged theme in {stage_sddm(args[args.index('--sddm-stage') + 1])}")
    if "--sddm" in args:
        install_sddm()
    if "--no-reload" not in args:
        reload_apps()
        print("reloaded hyprland, waybar, swaync, swayosd, ghostty, tmux (btop/starship: next launch/prompt)")


if __name__ == "__main__":
    main()
